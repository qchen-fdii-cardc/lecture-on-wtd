   "id": "b9e50d28",
   "metadata": {},
   "outputs": [],
   "source": [
    "import cadquery as cq\n",
    "\n",
    "# 参数驱动的几何体设计与建模\n",
    "length = 100  # 长度参数\n",
    "width = 50    # 宽度参数\n",
    "height = 30   # 高度参数\n",
    "\n",
    "# 创建一个参数化的长方体\n",
    "box = cq.Workplane(\"XY\").box(length, width, height)\n",
    "\n",
    "# 显示几何体\n",
    "cq.show_object(box)"
   ]
  }
