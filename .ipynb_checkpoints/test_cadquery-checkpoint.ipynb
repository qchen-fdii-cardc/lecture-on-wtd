   "source": [
    "import cadquery as cq\n",
    "# Define parameters for the model\n",
    "length = 100\n",
    "width = 50\n",
    "height = 30\n",
    "hole_diameter = 40\n",
    "\n",
    "model = (\n",
    "    cq.Workplane(\"XY\")\n",
    "    .box(length, width, height)\n",
    "    .faces(\">Z\").workplane()\n",
    "    .circle(hole_diameter / 2)\n",
    "    .cutThruAll()\n",
    ")\n"
   ]
